#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: aptup [--dry-run | --help]

Refresh APT package lists, then upgrade installed packages without removals.
  --dry-run  Show commands without running them.
  --help     Show this help.

Requires Linux, Bash, APT 2.2+ and sudo (unless root).
HELP
}

if (( $# > 1 )); then
  usage >&2
  exit 2
fi
case "${1:-}" in
  '') ;;
  --dry-run) ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

privilege=()
if (( EUID != 0 )); then
  privilege=(sudo)
fi
update=(apt-get --error-on=any update)
upgrade=(apt-get -o quiet=0 -o APT::Get::Assume-Yes=false --no-remove upgrade)

printf 'Planned commands:\n  '
printf '%q ' "${privilege[@]}" "${update[@]}"
printf '\n  '
printf '%q ' "${privilege[@]}" "${upgrade[@]}"
printf '\n'
[[ ${1:-} != --dry-run ]] || exit 0

if [[ $OSTYPE != linux* ]] || ! command -v apt-get >/dev/null; then
  printf 'aptup: Linux with apt-get is required.\n' >&2
  exit 1
fi
if (( EUID != 0 )) && ! command -v sudo >/dev/null; then
  printf 'aptup: sudo is required unless running as root.\n' >&2
  exit 1
fi
if [[ ! -t 0 ]]; then
  printf 'aptup: An interactive terminal is required. Use --dry-run to preview.\n' >&2
  exit 1
fi

printf '\nContinue? [y/N] '
answer=
if ! read -r answer; then
  answer=
fi
case "$answer" in
  y|Y|yes|YES|Yes) ;;
  *) printf 'Cancelled.\n'; exit 0 ;;
esac

# Stop on any failure. Keep APT's own confirmation and forbid package removals.
"${privilege[@]}" "${update[@]}"
"${privilege[@]}" "${upgrade[@]}"
